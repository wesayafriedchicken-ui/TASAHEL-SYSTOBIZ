import React, { useState } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  Database, 
  Webhook, 
  Code, 
  Zap, 
  Layout, 
  Table as TableIcon, 
  ArrowRight, 
  Terminal, 
  Key, 
  CheckCircle2, 
  Loader2, 
  AlertCircle,
  FileSpreadsheet
} from 'lucide-react';
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';

function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}

interface IntegrationCardProps {
  id: string;
  title: string;
  description: string;
  icon: any;
  status: 'connected' | 'not_connected' | 'coming_soon';
  onClick: () => void;
}

const IntegrationCard = ({ title, description, icon: Icon, status, onClick }: IntegrationCardProps) => (
  <button 
    onClick={onClick}
    className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all text-left flex flex-col h-full group"
  >
    <div className="flex items-start justify-between mb-4">
      <div className="p-3 bg-slate-50 rounded-xl group-hover:bg-indigo-50 transition-colors">
        <Icon className="w-6 h-6 text-slate-600 group-hover:text-indigo-600" />
      </div>
      <div className={cn(
        "px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider",
        status === 'connected' ? "bg-emerald-100 text-emerald-600" : 
        status === 'not_connected' ? "bg-slate-100 text-slate-500" : "bg-amber-100 text-amber-600"
      )}>
        {status.replace('_', ' ')}
      </div>
    </div>
    <h3 className="text-lg font-bold text-slate-800 mb-1">{title}</h3>
    <p className="text-sm text-slate-500 line-clamp-2">{description}</p>
    <div className="mt-auto pt-6 flex items-center gap-2 text-indigo-600 text-xs font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
      Configure <ArrowRight className="w-3 h-3" />
    </div>
  </button>
);

const IntegrationHub = () => {
  const [activeTab, setActiveTab] = useState<'overview' | 'api_keys' | 'logs'>('overview');
  const [selectedIntegration, setSelectedIntegration] = useState<string | null>(null);
  const [sheetsUrl, setSheetsUrl] = useState('');
  const [destination, setDestination] = useState('crm');
  const [isSyncing, setIsSyncing] = useState(false);
  const [syncResult, setSyncResult] = useState<{ message: string; type: 'success' | 'error' } | null>(null);
  const [apiKeys, setApiKeys] = useState({
    google_sheets: '••••••••••••••••••••••••••••',
    zapier: '',
    custom_api: ''
  });

  const handleSync = async () => {
    if (!sheetsUrl) return;
    setIsSyncing(true);
    setSyncResult(null);

    // Simulate network delay
    await new Promise(resolve => setTimeout(resolve, 2000));

    const count = Math.floor(Math.random() * 20) + 5;
    const destName = destination === 'crm' ? 'CRM Leads' : 'KPI Metrics';
    const message = `Successfully pulled ${count} new ${destName} from Google Sheets!`;

    setSyncResult({ message, type: 'success' });
    setIsSyncing(false);

    // Record in local Audit Logs (simulated)
    const currentUser = JSON.parse(localStorage.getItem('user') || '{"id": 1, "name": "Admin"}');
    const auditLog = {
      id: Date.now(),
      admin_id: currentUser.id,
      admin_name: currentUser.name,
      action: 'SYNC_DATA',
      module: 'Integration Hub',
      details: `Google Sheets Sync to ${destName}: ${count} records processed.`,
      created_at: new Date().toISOString()
    };
    
    const localLogs = JSON.parse(localStorage.getItem('business_core_audit_logs') || '[]');
    localStorage.setItem('business_core_audit_logs', JSON.stringify([auditLog, ...localLogs]));

    // Also trigger Real API if needed (simulation)
    fetch('/api/admin/audit-logs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(auditLog)
    }).catch(console.error);
  };

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div className="flex bg-slate-100 p-1 rounded-xl">
          {(['overview', 'api_keys', 'logs'] as const).map((tab) => (
            <button
              key={tab}
              onClick={() => setActiveTab(tab)}
              className={cn(
                "px-4 py-2 rounded-lg text-sm font-bold transition-all",
                activeTab === tab 
                  ? "bg-white text-indigo-600 shadow-sm" 
                  : "text-slate-500 hover:text-slate-700"
              )}
            >
              {tab.replace('_', ' ').toUpperCase()}
            </button>
          ))}
        </div>
      </div>

      <AnimatePresence mode="wait">
        {activeTab === 'overview' && (
          <motion.div
            key="overview"
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6"
          >
            <IntegrationCard 
              id="gsheets"
              title="Google Sheets"
              description="Sync leads, metrics, and records directly from shared spreadsheets."
              icon={FileSpreadsheet}
              status="connected"
              onClick={() => setSelectedIntegration('gsheets')}
            />
            <IntegrationCard 
              id="webhooks"
              title="Webhooks"
              description="Receive real-time notifications from external services."
              icon={Webhook}
              status="not_connected"
              onClick={() => setSelectedIntegration('webhooks')}
            />
            <IntegrationCard 
              id="zapier"
              title="Zapier"
              description="Connect with 5000+ apps using automated workflows."
              icon={Zap}
              status="coming_soon"
              onClick={() => setSelectedIntegration('zapier')}
            />
            <IntegrationCard 
              id="api"
              title="API Connect"
              description="Custom REST API integration for enterprise systems."
              icon={Code}
              status="not_connected"
              onClick={() => setSelectedIntegration('api')}
            />
          </motion.div>
        )}

        {activeTab === 'api_keys' && (
          <motion.div
            key="api_keys"
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            className="bg-white rounded-2xl border border-slate-200 p-8 max-w-2xl"
          >
            <div className="flex items-center gap-3 mb-6">
              <Key className="w-6 h-6 text-indigo-600" />
              <h3 className="text-xl font-bold text-slate-800">Integration Credentials</h3>
            </div>
            <div className="space-y-6">
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Google Cloud API Key</label>
                <div className="flex gap-2">
                  <input 
                    type="password" 
                    value={apiKeys.google_sheets}
                    onChange={(e) => setApiKeys({...apiKeys, google_sheets: e.target.value})}
                    className="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500/20"
                    placeholder="Enter your API Key"
                  />
                  <button className="px-4 py-2 text-indigo-600 font-bold hover:bg-indigo-50 rounded-xl transition-colors">Show</button>
                </div>
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Zapier Webhook URL</label>
                <input 
                  type="text" 
                  value={apiKeys.zapier}
                  onChange={(e) => setApiKeys({...apiKeys, zapier: e.target.value})}
                  className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500/20"
                  placeholder="https://hooks.zapier.com/..."
                />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Custom API Secret</label>
                <input 
                  type="password" 
                  value={apiKeys.custom_api}
                  onChange={(e) => setApiKeys({...apiKeys, custom_api: e.target.value})}
                  className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500/20"
                />
              </div>
              <button className="w-full py-3 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-colors">
                Save Credentials
              </button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Configuration Modal */}
      <AnimatePresence>
        {selectedIntegration === 'gsheets' && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[60] flex items-center justify-center p-4"
          >
            <motion.div
              initial={{ scale: 0.95, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.95, opacity: 0 }}
              className="bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden"
            >
              <div className="p-8 border-b border-slate-100 flex items-center justify-between">
                <div className="flex items-center gap-4">
                  <div className="p-3 bg-emerald-50 rounded-2xl">
                    <FileSpreadsheet className="w-8 h-8 text-emerald-600" />
                  </div>
                  <div>
                    <h3 className="text-2xl font-bold text-slate-800">Google Sheets Sync</h3>
                    <p className="text-slate-500 text-sm">Update core data from spreadsheets</p>
                  </div>
                </div>
                <button onClick={() => setSelectedIntegration(null)} className="p-2 hover:bg-slate-100 rounded-full transition-colors">
                  <X className="w-6 h-6 text-slate-400" />
                </button>
              </div>

              <div className="p-8 space-y-6">
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">Document ID or Public URL</label>
                  <input 
                    type="text" 
                    value={sheetsUrl}
                    onChange={(e) => setSheetsUrl(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/20"
                    placeholder="https://docs.google.com/spreadsheets/d/..."
                  />
                </div>

                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">Destination Module</label>
                  <select 
                    value={destination}
                    onChange={(e) => setDestination(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500/20"
                  >
                    <option value="crm">CRM Leads & Customers</option>
                    <option value="kpi">KPI Dashboard (Metrics)</option>
                    <option value="inventory">Inventory (Coming Soon)</option>
                  </select>
                </div>

                <AnimatePresence>
                  {syncResult && (
                    <motion.div
                      initial={{ opacity: 0, y: -10 }}
                      animate={{ opacity: 1, y: 0 }}
                      exit={{ opacity: 0, y: -10 }}
                      className={cn(
                        "p-4 rounded-xl flex items-center gap-3",
                        syncResult.type === 'success' ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700"
                      )}
                    >
                      {syncResult.type === 'success' ? <CheckCircle2 className="w-5 h-5" /> : <AlertCircle className="w-5 h-5" />}
                      <p className="text-sm font-medium">{syncResult.message}</p>
                    </motion.div>
                  )}
                </AnimatePresence>

                <button 
                  disabled={!sheetsUrl || isSyncing}
                  onClick={handleSync}
                  className="w-full py-4 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 transition-all flex items-center justify-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-emerald-600/20"
                >
                  {isSyncing ? (
                    <>
                      <Loader2 className="w-5 h-5 animate-spin" />
                      Syncing Records...
                    </>
                  ) : (
                    <>
                      <Zap className="w-5 h-5 fill-current" />
                      Sync Now
                    </>
                  )}
                </button>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};

const X = ({ className, onClick }: { className?: string, onClick?: () => void }) => (
  <svg 
    onClick={onClick}
    xmlns="http://www.w3.org/2000/svg" 
    width="24" 
    height="24" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    strokeWidth="2" 
    strokeLinecap="round" 
    strokeLinejoin="round" 
    className={className}
  >
    <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
  </svg>
);

export default IntegrationHub;
